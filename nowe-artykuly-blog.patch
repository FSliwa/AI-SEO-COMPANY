+              <Zrodla zrodla={ZRODLA} />
+
+              <BlogCTA locale={locale} currentSlug={SCIEZKA} />
+            </div>
+          </Reveal>
+        </div>
+      </article>
+
+      <Contact />
+      <Footer />
+    </main>
+  );
+}
